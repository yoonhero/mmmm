   "source": [
    "from io import StringIO\n",
    "\n",
    "string_buffer = StringIO()\n",
    "\n",
    "string_buffer.write(\"Hello World\")\n",
    "\n",
    "string_buffer.seek(0, 2)\n",
    "\n",
    "string_buffer.read()"
   ]
